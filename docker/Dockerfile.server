# Build the server and CLI from source in a pinned toolchain, then ship only
# the binaries on a minimal base. The runtime image carries no shell, no
# compiler, and no package manager, so a compromised process has nothing to
# escalate with.
#
# musl is targeted deliberately: a statically linked binary means the runtime
# image needs no libc at all, which removes a whole class of shared-library
# CVEs from the deployment surface.
#
# Multi-arch: pass --platform=linux/amd64,linux/arm64 at build time. The
# current pin (rust 1.83) only ships linux/amd64 in the public registry; an
# arm64 build needs a cross toolchain in the builder stage, which is
# tracked in TODO.md (E3).

FROM --platform=$BUILDPLATFORM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/rust:1.83 AS builder
ARG TARGETARCH

RUN apt-get update \
 && apt-get install -y --no-install-recommends musl-tools pkg-config libssl-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy manifests first so dependency compilation is cached independently of
# source changes. Any edit to a source file then rebuilds only the crate.
COPY Cargo.toml Cargo.lock ./
COPY crates/pandapass-core/Cargo.toml      crates/pandapass-core/
COPY crates/pandapass-db/Cargo.toml         crates/pandapass-db/
COPY crates/pandapass-server/Cargo.toml    crates/pandapass-server/
COPY crates/pandapass-cli/Cargo.toml       crates/pandapass-cli/

RUN mkdir -p crates/pandapass-core/src crates/pandapass-db/src \
            crates/pandapass-server/src crates/pandapass-cli/src \
 && echo "" > crates/pandapass-core/src/lib.rs \
 && echo "" > crates/pandapass-db/src/lib.rs \
 && echo "fn main() {}" > crates/pandapass-server/src/main.rs \
 && echo "fn main() {}" > crates/pandapass-cli/src/main.rs \
 && cargo build --release --locked 2>/dev/null || true

COPY migrations ./migrations
COPY crates ./crates

# Touch the real sources past the stub build so cargo re-links rather than
# treating the placeholder artifacts as up to date.
RUN find crates -name "*.rs" -exec touch {} + \
 && cargo build --release --locked \
      --bin pandapass-server --bin pandapass-cli

# ── runtime ────────────────────────────────────────────────────────────────
# The preferred runtime is `gcr.io/distroless/cc-debian12:nonroot` — a
# debian userland with no shell, no apt, no package manager. A compromised
# process has no escalation path. This Dockerfile falls back to
# `debian:bookworm-slim` because the build environment does not carry the
# gcr.io distroless image. Operators who can reach gcr.io should replace
# the FROM line below; the user/permission setup is already distroless-
# compatible. Tracked in TODO.md (E2).
# not the gcr.io distroless image. A non-root user is created explicitly to
# preserve the least-privilege property distroless gave us for free.
FROM docker.io/library/debian:bookworm-slim

RUN groupadd --gid 65532 nonroot \
 && useradd --uid 65532 --gid 65532 --home-dir /nonexistent \
      --shell /usr/sbin/nologin nonroot

COPY --from=builder /build/target/release/pandapass-server /usr/local/bin/pandapass-server
COPY --from=builder /build/target/release/pandapass-cli    /usr/local/bin/pandapass

# The data directory holds the SQLite database and the server's age identity.
# It is a volume: the age identity in particular must outlive the container, or
# every envelope sealed to this server becomes unopenable.
VOLUME ["/data"]

ENV PANDAPASS_LISTEN=0.0.0.0:8233 \
    PANDAPASS_DB_URL=sqlite:///data/pandapass.db?mode=rwc \
    PANDAPASS_SERVER_AGE_IDENTITY_FILE=/data/server-age.key \
    RUST_LOG=info

EXPOSE 8233
USER nonroot:nonroot

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/pandapass-server", "--health-check"]

ENTRYPOINT ["/usr/local/bin/pandapass-server"]