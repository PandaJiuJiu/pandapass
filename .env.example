# Copy to `.env` and edit before the first boot. Every value here is a default
# or an example — nothing secret belongs in this file, and `.env` is gitignored.

# ── required ────────────────────────────────────────────────────────────────

# The public URL users actually reach. Setting an https:// URL is what turns on
# the Secure cookie flag; leaving it http:// means the session cookie will cross
# the network in cleartext.
PANDAPASS_PUBLIC_URL=https://vault.example.internal

# ── access control ──────────────────────────────────────────────────────────

# Leave this off. Turn it on only long enough to create the first account, then
# turn it back off — the first account bootstraps as admin and later signups are
# refused regardless.
PANDAPASS_ALLOW_REGISTRATION=false

# Comma-separated. Empty means same-origin only, which is correct when the web
# UI is served from the same host through nginx.
PANDAPASS_ALLOWED_ORIGINS=

# Force TOTP on every account. Worth enabling for any real deployment.
PANDAPASS_REQUIRE_TOTP=false

PANDAPASS_SESSION_TTL_DAYS=30

# ── agent execution ─────────────────────────────────────────────────────────

# Comma-separated executables `pandapass run` is permitted to spawn. Empty means
# no restriction, which is fine for a human at a terminal but not for an agent:
# setting this bounds what a leaked token can do even if it holds read:secret.
#
# Example: PANDAPASS_COMMAND_ALLOWLIST=aws,kubectl,psql,psql,migrate.sh
PANDAPASS_COMMAND_ALLOWLIST=
PANDAPASS_COMMAND_TIMEOUT_SECS=120

# ── advanced ────────────────────────────────────────────────────────────────

# Uncomment only if something in front (nginx, a CDN) needs the forwarded
# scheme. Leave unset otherwise — the default derives it correctly.
# PANDAPASS_COOKIE_SECURE=true

# Request metadata only. Secret values are never logged, at any level.
RUST_LOG=info

# NOTE: the database URL and the server's age identity are configured in
# docker-compose.yml, not here.
#
# The database URL must be sqlite:///data/pandapass.db — three slashes. With two,
# SQLite reads the path as relative, the server writes inside the container
# instead of the volume, and every recreate loses the vault.
#
# The age identity is generated on first boot into /data/server-age.key. It is
# not set here because a private key in an environment variable shows up in
# `docker inspect` and `docker compose config`.
